# Local dev (SQLite, file-based, zero setup):
DATABASE_URL="file:./dev.db"

# --- Only needed when deploying to Vercel (or any host without a persistent
# local disk) with a Turso database. Leave both unset for local dev — the
# app falls back to the plain local SQLite file above automatically.
# See README.md "Deploying for phone access" for the full walkthrough.
# TURSO_DATABASE_URL="libsql://<your-db-name>-<org>.turso.io"
# TURSO_AUTH_TOKEN="<token from: turso db tokens create <db-name>>"
