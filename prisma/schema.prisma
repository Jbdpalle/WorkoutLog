generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Settings {
  id               Int       @id @default(1)
  waterGoalMl      Int       @default(2500)
  sleepGoalHrs     Float     @default(8)
  programStartDate DateTime?
}

model WaterLog {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  amountMl  Int
  createdAt DateTime @default(now())
}

model SleepLog {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  hours     Float
  quality   Int?
  notes     String?
  createdAt DateTime @default(now())
}

model WorkoutLog {
  id          String     @id @default(cuid())
  date        DateTime   @default(now())
  workoutType String
  phaseLabel  String?
  programDay  Int?
  rounds      Int        @default(2)
  durationMin Float?
  notes       String?
  exercises   Exercise[]
  createdAt   DateTime   @default(now())
}

model Exercise {
  id         String     @id @default(cuid())
  workoutId  String
  workout    WorkoutLog @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  round      Int        @default(1)
  name       String
  targetReps String?
  actualReps String?
  order      Int        @default(0)
}
